{
  "entities": {
    "CloudSnapshot": {
      "title": "Cloud Snapshot",
      "description": "Stores server-managed database backups and account/request vaults restricted to super_admin.",
      "type": "object",
      "properties": {
        "sql_dump": { "type": "string", "description": "Serialized backup payload." },
        "vault_json": { "type": "string", "description": "Serialized school accounts and requests registry payload." },
        "school_count": { "type": "integer" },
        "non_default_school_count": { "type": "integer" },
        "non_test_user_count": { "type": "integer" },
        "request_count": { "type": "integer" },
        "build_id": { "type": "string" },
        "last_updated": { "type": "string", "format": "date-time" },
        "version": { "type": "integer" }
      },
      "required": ["last_updated"]
    },
    "SchoolRecord": {
      "title": "School Record",
      "description": "Tenant school entity.",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "nom": { "type": "string" },
        "code_ecole": { "type": "string" }
      },
      "required": ["nom"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated user identity and tenant membership.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "school_id": { "type": "integer" }
      },
      "required": ["email", "role"]
    },
    "TenantEntity": {
      "title": "Tenant Scoped Entity",
      "description": "Generic school-isolated operational document.",
      "type": "object",
      "properties": {
        "school_id": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["school_id"]
    },
    "AppDataDoc": {
      "title": "Application Data Document",
      "description": "School-scoped cached application data document.",
      "type": "object",
      "properties": {
        "school_id": { "type": "integer" },
        "payload": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["school_id", "payload"]
    }
  },
  "firestore": {
    "/backups/{checkpointId}": {
      "schema": "CloudSnapshot",
      "description": "Restricted master checkpoints (super_admin only)."
    },
    "/test/{testId}": {
      "schema": "AppDataDoc",
      "description": "Authenticated health check documents."
    },
    "/schools/{schoolId}": {
      "schema": "SchoolRecord",
      "description": "Registered school tenants."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user profiles with tenant role binding."
    },
    "/classes/{classId}": {
      "schema": "TenantEntity",
      "description": "School-scoped classes."
    },
    "/students/{studentId}": {
      "schema": "TenantEntity",
      "description": "School-scoped student records."
    },
    "/grades/{gradeId}": {
      "schema": "TenantEntity",
      "description": "School-scoped grade records."
    },
    "/settings/{settingId}": {
      "schema": "TenantEntity",
      "description": "School-scoped settings."
    },
    "/app_data/{docId}": {
      "schema": "AppDataDoc",
      "description": "School-scoped application data documents."
    }
  }
}
