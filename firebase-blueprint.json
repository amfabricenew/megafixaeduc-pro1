{
  "entities": {
    "CloudSnapshot": {
      "title": "Cloud Snapshot",
      "description": "Stores server-managed database backups, chunks, and account/request vaults restricted to super_admin.",
      "type": "object",
      "properties": {
        "last_updated": { "type": "string", "format": "date-time", "maxLength": 64 },
        "version": { "type": "integer" },
        "build_id": { "type": "string", "maxLength": 128 },
        "has_real_data": { "type": "boolean" },
        "school_count": { "type": "integer" },
        "non_default_school_count": { "type": "integer" },
        "user_count": { "type": "integer" },
        "non_test_user_count": { "type": "integer" },
        "student_count": { "type": "integer" },
        "request_count": { "type": "integer" },
        "checksum": { "type": "string", "maxLength": 128 },
        "encoding": { "type": "string", "maxLength": 64 },
        "chunk_count": { "type": "integer" },
        "sql_dump": { "type": "string", "maxLength": 900000, "description": "Serialized backup payload." },
        "vault_json": { "type": "string", "maxLength": 900000, "description": "Serialized school accounts and requests registry payload." },
        "index": { "type": "integer" },
        "total": { "type": "integer" },
        "data": { "type": "string", "maxLength": 900000 },
        "archived_at": { "type": "string", "format": "date-time", "maxLength": 64 },
        "archive_reason": { "type": "string", "maxLength": 200 },
        "school_id": { "type": "integer" },
        "snapshot_id": { "type": "integer" },
        "filename": { "type": "string", "maxLength": 255 },
        "label": { "type": "string", "maxLength": 255 },
        "backup_type": { "type": "string", "maxLength": 64 },
        "format": { "type": "string", "maxLength": 32 },
        "size_bytes": { "type": "integer" },
        "checksum_sha256": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 },
        "storage_location": { "type": "string", "maxLength": 64 }
      },
      "required": ["last_updated"]
    },
    "SchoolRecord": {
      "title": "School Record",
      "description": "Tenant school entity persisted in Cloud Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "nom": { "type": "string", "minLength": 1, "maxLength": 200 },
        "code_ecole": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 254 },
        "telephone": { "type": "string", "maxLength": 40 },
        "pays": { "type": "string", "maxLength": 80 },
        "devise": { "type": "string", "maxLength": 16 },
        "plan_abonnement": { "type": "string", "maxLength": 80 },
        "statut_abonnement": { "type": "string", "maxLength": 40 },
        "date_fin_abonnement": { "type": "string", "maxLength": 64 },
        "espace_primaire_actif": { "type": "integer" },
        "espace_secondaire_actif": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["nom"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated user identity and tenant role binding.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "role": { "type": "string", "minLength": 2, "maxLength": 40 },
        "school_id": { "type": "integer" },
        "nom": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["email", "role"]
    },
    "SuperAdminSetting": {
      "title": "Super Admin Setting",
      "description": "Global platform configuration entry stored in Cloud Firestore (restricted to super_admin).",
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "maxLength": 200000 },
        "is_secret": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["key", "value", "updatedAt"]
    },
    "SubscriptionPlan": {
      "title": "Subscription Plan",
      "description": "Subscription formula configured by the Super Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "price": { "type": "number" },
        "period": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "maxLength": 40 },
        "color": { "type": "string", "maxLength": 40 },
        "student_limit": { "type": "integer" },
        "staff_limit": { "type": "integer" },
        "is_recommended": { "type": "boolean" },
        "is_active": { "type": "boolean" },
        "features": { "type": "array", "description": "Active features assigned to the plan." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "name", "price", "updatedAt"]
    },
    "SchoolRequest": {
      "title": "School Creation Request",
      "description": "School onboarding request submitted on the platform (super_admin only).",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "reference": { "type": "string", "minLength": 3, "maxLength": 64 },
        "nom_ecole": { "type": "string", "minLength": 1, "maxLength": 200 },
        "email_ecole": { "type": "string", "maxLength": 254 },
        "demandeur_nom": { "type": "string", "maxLength": 150 },
        "demandeur_email": { "type": "string", "maxLength": 254 },
        "plan_souhaite": { "type": "string", "maxLength": 120 },
        "statut": { "type": "string", "maxLength": 40 },
        "school_id": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["reference", "nom_ecole", "statut", "updatedAt"]
    },
    "TenantEntity": {
      "title": "Tenant Scoped Entity",
      "description": "Generic school-isolated operational document.",
      "type": "object",
      "properties": {
        "school_id": { "type": "integer" },
        "payload": { "type": "string", "maxLength": 800000 },
        "status": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["school_id"]
    },
    "AppDataDoc": {
      "title": "Application Data Document",
      "description": "School-scoped cached application data document.",
      "type": "object",
      "properties": {
        "school_id": { "type": "integer" },
        "payload": { "type": "string", "maxLength": 800000 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["school_id", "payload"]
    }
  },
  "firestore": {
    "/backups/{checkpointId}": {
      "schema": "CloudSnapshot",
      "description": "Restricted master checkpoints, chunks, and school vault (super_admin only)."
    },
    "/test/{testId}": {
      "schema": "AppDataDoc",
      "description": "Authenticated health check documents."
    },
    "/schools/{schoolId}": {
      "schema": "SchoolRecord",
      "description": "Registered school tenants."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user profiles with tenant role binding."
    },
    "/super_admin_settings/{settingId}": {
      "schema": "SuperAdminSetting",
      "description": "Global platform configuration persisted across deployments (super_admin only)."
    },
    "/plans/{planId}": {
      "schema": "SubscriptionPlan",
      "description": "Configured subscription plans and feature matrices."
    },
    "/school_requests/{requestId}": {
      "schema": "SchoolRequest",
      "description": "School account creation requests and approval statuses (super_admin only)."
    },
    "/classes/{classId}": {
      "schema": "TenantEntity",
      "description": "School-scoped classes."
    },
    "/students/{studentId}": {
      "schema": "TenantEntity",
      "description": "School-scoped student records."
    },
    "/grades/{gradeId}": {
      "schema": "TenantEntity",
      "description": "School-scoped grade records."
    },
    "/settings/{settingId}": {
      "schema": "TenantEntity",
      "description": "School-scoped settings."
    },
    "/app_data/{docId}": {
      "schema": "AppDataDoc",
      "description": "School-scoped application data documents."
    }
  }
}
