{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && (mkdir -p build && cp -r dist/* build/ 2>/dev/null || true)",
    "render-build": "npm run build",
    "start": "node dist/server.cjs || node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "zip": "python3 scripts/create-zip.py",
    "lint": "tsc --noEmit"
  },
