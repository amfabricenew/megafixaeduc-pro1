rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Default Deny Catch-All (Global Safety Net)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Helper Functions
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function userProfile() {
      return get(userDocPath()).data;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['ayedeguef@gmail.com', 'amfabricenew@gmail.com'];
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() || (hasUserProfile() && userProfile().role == 'super_admin');
    }

    function isSameSchool(schoolId) {
      return hasUserProfile()
        && userProfile().school_id != null
        && string(userProfile().school_id) == string(schoolId);
    }

    function isSchoolAdmin(schoolId) {
      return isSameSchool(schoolId)
        && userProfile().role in ['admin', 'fonde', 'direction'];
    }

    function hasSchoolField(docData) {
      return docData.keys().hasAll(['school_id'])
        && (docData.school_id is int || (docData.school_id is string && docData.school_id.size() > 0 && docData.school_id.size() <= 64));
    }

    function unchangedSchoolId() {
      return existing().school_id == incoming().school_id;
    }

    function isValidBackupDoc(data) {
      return data is map
        && data.keys().hasAll(['last_updated'])
        && data.last_updated is string
        && data.last_updated.size() > 0
        && data.last_updated.size() <= 64;
    }

    function isValidSchoolDoc(data) {
      return data is map
        && data.keys().hasAll(['nom'])
        && data.nom is string && data.nom.size() > 0 && data.nom.size() <= 200;
    }

    function isValidUserDoc(data) {
      return data is map
        && data.keys().hasAll(['role', 'email'])
        && data.role is string && data.role.size() > 0 && data.role.size() <= 40
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254;
    }

    function isValidScopedDoc(data) {
      return data is map && hasSchoolField(data);
    }

    // =========================================================================
    // Connectivity Check (Signed-in Only, Read-Only, Single Document Get)
    // =========================================================================
    match /test/{testId} {
      allow get: if isSignedIn() && isValidId(testId);
      allow list, write: if false;
    }

    // =========================================================================
    // Global Database Backups & Checkpoints (Strictly Super-Admin Only)
    // =========================================================================
    match /backups/{checkpointId} {
      allow get: if isValidId(checkpointId) && isSuperAdmin();
      allow list: if false;
      allow create, update: if isValidId(checkpointId) && isSuperAdmin() && isValidBackupDoc(incoming());
      allow delete: if isValidId(checkpointId) && isSuperAdmin();
    }

    // =========================================================================
    // Multi-Tenant Schools Registry
    // =========================================================================
    match /schools/{schoolId} {
      allow get: if isValidId(schoolId) && (isSuperAdmin() || isSameSchool(schoolId));
      allow list: if false;
      allow create: if isValidId(schoolId) && isValidSchoolDoc(incoming()) && isSuperAdmin();
      allow update: if isValidId(schoolId) && isValidSchoolDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(schoolId));
      allow delete: if isValidId(schoolId) && isSuperAdmin();
    }

    // =========================================================================
    // User Profiles (Ownership & School-Scoped Admin Access; No Role Escalation)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSchoolAdmin(existing().school_id))
      );
      allow list: if false;
      allow create: if isValidId(userId) && isValidUserDoc(incoming()) && isSuperAdmin();
      allow update: if isValidId(userId) && isSignedIn() && isValidUserDoc(incoming()) && (
        isSuperAdmin() ||
        (request.auth.uid == userId && incoming().role == existing().role && unchangedSchoolId())
      );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // =========================================================================
    // School-Scoped Operational Collections
    // =========================================================================
    match /classes/{classId} {
      allow get: if isValidId(classId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isValidId(classId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isValidId(classId) && isValidScopedDoc(incoming()) && hasSchoolField(existing()) && unchangedSchoolId() && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
      allow delete: if isValidId(classId) && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isValidId(studentId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isValidId(studentId) && isValidScopedDoc(incoming()) && hasSchoolField(existing()) && unchangedSchoolId() && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
      allow delete: if isValidId(studentId) && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /grades/{gradeId} {
      allow get: if isValidId(gradeId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isValidId(gradeId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isValidId(gradeId) && isValidScopedDoc(incoming()) && hasSchoolField(existing()) && unchangedSchoolId() && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
      allow delete: if isValidId(gradeId) && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isValidId(settingId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isValidId(settingId) && isValidScopedDoc(incoming()) && hasSchoolField(existing()) && unchangedSchoolId() && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
      allow delete: if isValidId(settingId) && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /app_data/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isValidId(docId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isValidId(docId) && isValidScopedDoc(incoming()) && hasSchoolField(existing()) && unchangedSchoolId() && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
      allow delete: if isValidId(docId) && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }
  }
}
