rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Default Deny Catch-All (Global Safety Net)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Helper Functions
    // =========================================================================
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function userProfile() {
      return get(userDocPath()).data;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['ayedeguef@gmail.com', 'amfabricenew@gmail.com'];
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin()
        || (hasUserProfile() && userProfile().role == 'super_admin');
    }

    function isSameSchool(schoolId) {
      return hasUserProfile()
        && userProfile().school_id != null
        && (
          string(userProfile().school_id) == string(schoolId)
          || ('school_' + string(userProfile().school_id)) == string(schoolId)
        );
    }

    function isSchoolAdmin(schoolId) {
      return isSameSchool(schoolId)
        && userProfile().role in ['admin', 'fonde', 'direction', 'directeur', 'fondateur'];
    }

    function hasSchoolField(docData) {
      return docData.keys().hasAll(['school_id'])
        && (
          docData.school_id is int
          || (docData.school_id is string && docData.school_id.size() > 0 && docData.school_id.size() <= 64)
        );
    }

    function unchangedSchoolId() {
      return existing().school_id == incoming().school_id;
    }

    function isValidBackupDoc(data) {
      return data is map
        && data.keys().hasAll(['last_updated'])
        && data.keys().hasOnly([
          'last_updated', 'version', 'build_id', 'has_real_data',
          'school_count', 'non_default_school_count', 'user_count',
          'non_test_user_count', 'student_count', 'request_count',
          'checksum', 'encoding', 'chunk_count', 'sql_dump', 'vault_json',
          'index', 'total', 'data', 'archived_at', 'archive_reason',
          'school_id', 'snapshot_id', 'filename', 'label', 'backup_type',
          'format', 'size_bytes', 'checksum_sha256', 'created_at',
          'status', 'storage_location'
        ])
        && data.last_updated is string && data.last_updated.size() > 0 && data.last_updated.size() <= 64
        && (!('build_id' in data) || (data.build_id is string && data.build_id.size() <= 128))
        && (!('checksum' in data) || (data.checksum is string && data.checksum.size() <= 128))
        && (!('encoding' in data) || (data.encoding is string && data.encoding.size() <= 64))
        && (!('sql_dump' in data) || (data.sql_dump is string && data.sql_dump.size() <= 900000))
        && (!('vault_json' in data) || (data.vault_json is string && data.vault_json.size() <= 900000))
        && (!('data' in data) || (data.data is string && data.data.size() <= 900000))
        && (!('version' in data) || data.version is int)
        && (!('school_count' in data) || data.school_count is int)
        && (!('non_default_school_count' in data) || data.non_default_school_count is int)
        && (!('user_count' in data) || data.user_count is int)
        && (!('non_test_user_count' in data) || data.non_test_user_count is int)
        && (!('student_count' in data) || data.student_count is int)
        && (!('request_count' in data) || data.request_count is int)
        && (!('chunk_count' in data) || data.chunk_count is int)
        && (!('index' in data) || data.index is int)
        && (!('total' in data) || data.total is int)
        && (!('has_real_data' in data) || data.has_real_data is bool);
    }

    function isValidSchoolDoc(data) {
      return data is map
        && data.keys().hasAll(['nom'])
        && data.keys().hasOnly([
          'id', 'nom', 'code_ecole', 'email', 'telephone', 'pays', 'devise',
          'plan_abonnement', 'statut_abonnement', 'date_fin_abonnement',
          'espace_primaire_actif', 'espace_secondaire_actif', 'updatedAt'
        ])
        && data.nom is string && data.nom.size() > 0 && data.nom.size() <= 200
        && (!('id' in data) || data.id is int)
        && (!('code_ecole' in data) || (data.code_ecole is string && data.code_ecole.size() <= 64))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('telephone' in data) || (data.telephone is string && data.telephone.size() <= 40))
        && (!('pays' in data) || (data.pays is string && data.pays.size() <= 80))
        && (!('devise' in data) || (data.devise is string && data.devise.size() <= 16))
        && (!('plan_abonnement' in data) || (data.plan_abonnement is string && data.plan_abonnement.size() <= 80))
        && (!('statut_abonnement' in data) || (data.statut_abonnement is string && data.statut_abonnement.size() <= 40))
        && (!('date_fin_abonnement' in data) || (data.date_fin_abonnement is string && data.date_fin_abonnement.size() <= 64))
        && (!('espace_primaire_actif' in data) || data.espace_primaire_actif is int)
        && (!('espace_secondaire_actif' in data) || data.espace_secondaire_actif is int)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserDoc(data) {
      return data is map
        && data.keys().hasAll(['role', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'school_id', 'nom', 'updatedAt'])
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 40
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('uid' in data) || isValidId(data.uid))
        && (!('school_id' in data) || data.school_id is int)
        && (!('nom' in data) || (data.nom is string && data.nom.size() <= 150))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSuperAdminSettingDoc(data) {
      return data is map
        && data.keys().hasAll(['key', 'value', 'updatedAt'])
        && data.keys().hasOnly(['key', 'value', 'is_secret', 'updatedAt'])
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 100
        && data.value is string && data.value.size() <= 200000
        && (!('is_secret' in data) || data.is_secret is bool)
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidPlanDoc(data) {
      return data is map
        && data.keys().hasAll(['id', 'name', 'price', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'price', 'period', 'type', 'color',
          'student_limit', 'staff_limit', 'is_recommended', 'is_active',
          'features', 'updatedAt'
        ])
        && data.id is int
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (data.price is int || data.price is float)
        && (!('period' in data) || (data.period is string && data.period.size() <= 40))
        && (!('type' in data) || (data.type is string && data.type.size() <= 40))
        && (!('color' in data) || (data.color is string && data.color.size() <= 40))
        && (!('student_limit' in data) || data.student_limit is int)
        && (!('staff_limit' in data) || data.staff_limit is int)
        && (!('is_recommended' in data) || data.is_recommended is bool)
        && (!('is_active' in data) || data.is_active is bool)
        && (!('features' in data) || (
          data.features is list
          && data.features.size() <= 60
          && (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 120))
        ))
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidSchoolRequestDoc(data) {
      return data is map
        && data.keys().hasAll(['reference', 'nom_ecole', 'statut', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'reference', 'nom_ecole', 'email_ecole',
          'demandeur_nom', 'demandeur_email', 'plan_souhaite',
          'statut', 'school_id', 'updatedAt'
        ])
        && data.reference is string && data.reference.size() >= 3 && data.reference.size() <= 64
        && data.nom_ecole is string && data.nom_ecole.size() >= 1 && data.nom_ecole.size() <= 200
        && data.statut is string && data.statut.size() >= 2 && data.statut.size() <= 40
        && (!('id' in data) || data.id is int)
        && (!('email_ecole' in data) || (data.email_ecole is string && data.email_ecole.size() <= 254))
        && (!('demandeur_nom' in data) || (data.demandeur_nom is string && data.demandeur_nom.size() <= 150))
        && (!('demandeur_email' in data) || (data.demandeur_email is string && data.demandeur_email.size() <= 254))
        && (!('plan_souhaite' in data) || (data.plan_souhaite is string && data.plan_souhaite.size() <= 120))
        && (!('school_id' in data) || data.school_id is int)
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidScopedDoc(data) {
      return data is map
        && hasSchoolField(data)
        && data.keys().hasOnly(['school_id', 'payload', 'status', 'updatedAt'])
        && (!('payload' in data) || (data.payload is string && data.payload.size() <= 800000))
        && (!('status' in data) || (data.status is string && data.status.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAppDataDoc(data) {
      return data is map
        && hasSchoolField(data)
        && data.keys().hasAll(['school_id', 'payload'])
        && data.keys().hasOnly(['school_id', 'payload', 'updatedAt'])
        && data.payload is string && data.payload.size() <= 800000
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // =========================================================================
    // Connectivity Check (Signed-in Only, Read-Only, Single Document Get)
    // =========================================================================
    match /test/{testId} {
      allow get: if isSignedIn() && isValidId(testId);
      allow list, write: if false;
    }

    // =========================================================================
    // Global Database Backups & Checkpoints (Strictly Super-Admin Only)
    // =========================================================================
    match /backups/{checkpointId} {
      allow get: if isSignedIn() && isValidId(checkpointId) && isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() && isValidId(checkpointId) && isValidBackupDoc(incoming()) && isSuperAdmin();
      allow update: if isSignedIn() && isValidId(checkpointId) && isValidBackupDoc(incoming()) && isSuperAdmin();
      allow delete: if isSignedIn() && isValidId(checkpointId) && resource != null && isSuperAdmin();
    }

    // =========================================================================
    // Super Admin Platform Settings & Requests (Strictly Super-Admin Only)
    // =========================================================================
    match /super_admin_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() && isValidId(settingId) && isValidSuperAdminSettingDoc(incoming()) && isSuperAdmin();
      allow update: if isSignedIn() && isValidId(settingId) && isValidSuperAdminSettingDoc(incoming()) && resource != null && isSuperAdmin();
      allow delete: if isSignedIn() && isValidId(settingId) && resource != null && isSuperAdmin();
    }

    match /plans/{planId} {
      allow get: if isSignedIn() && isValidId(planId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(planId) && isValidPlanDoc(incoming()) && isSuperAdmin();
      allow update: if isSignedIn() && isValidId(planId) && isValidPlanDoc(incoming()) && resource != null && isSuperAdmin();
      allow delete: if isSignedIn() && isValidId(planId) && resource != null && isSuperAdmin();
    }

    match /school_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && isSuperAdmin();
      allow list: if false;
      allow create: if isSignedIn() && isValidId(requestId) && isValidSchoolRequestDoc(incoming()) && isSuperAdmin();
      allow update: if isSignedIn() && isValidId(requestId) && isValidSchoolRequestDoc(incoming()) && resource != null && isSuperAdmin();
      allow delete: if isSignedIn() && isValidId(requestId) && resource != null && isSuperAdmin();
    }

    // =========================================================================
    // Multi-Tenant Schools Registry
    // =========================================================================
    match /schools/{schoolId} {
      allow get: if isSignedIn() && isValidId(schoolId) && (isSuperAdmin() || isSameSchool(schoolId));
      allow list: if false;
      allow create: if isSignedIn() && isValidId(schoolId) && isValidSchoolDoc(incoming()) && isSuperAdmin();
      allow update: if isSignedIn() && isValidId(schoolId) && isValidSchoolDoc(incoming()) && resource != null && (
        isSuperAdmin() ||
        (
          isSchoolAdmin(schoolId)
          && (!('id' in existing()) || incoming().id == existing().id)
          && incoming().diff(existing()).affectedKeys().hasOnly(['nom', 'email', 'telephone', 'pays', 'devise', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && isValidId(schoolId) && resource != null && isSuperAdmin();
    }

    // =========================================================================
    // User Profiles (Ownership & School-Scoped Admin Access; No Role Escalation)
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSchoolAdmin(existing().school_id))
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserDoc(incoming()) && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId
          && (!('uid' in incoming()) || incoming().uid == request.auth.uid)
          && incoming().email == request.auth.token.email
          && incoming().role == 'user'
        )
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserDoc(incoming()) && resource != null && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId
          && incoming().role == existing().role
          && (!('uid' in incoming()) || incoming().uid == existing().uid)
          && incoming().email == existing().email
          && (!hasSchoolField(existing()) || unchangedSchoolId())
          && incoming().diff(existing()).affectedKeys().hasOnly(['nom', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && isValidId(userId) && resource != null && isSuperAdmin();
    }

    // =========================================================================
    // School-Scoped Operational Collections
    // =========================================================================
    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(classId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isSignedIn() && isValidId(classId) && isValidScopedDoc(incoming()) && resource != null && hasSchoolField(existing()) && unchangedSchoolId() && (
        isSuperAdmin() ||
        (isSchoolAdmin(existing().school_id) && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(classId) && resource != null && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(studentId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isSignedIn() && isValidId(studentId) && isValidScopedDoc(incoming()) && resource != null && hasSchoolField(existing()) && unchangedSchoolId() && (
        isSuperAdmin() ||
        (isSchoolAdmin(existing().school_id) && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(studentId) && resource != null && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /grades/{gradeId} {
      allow get: if isSignedIn() && isValidId(gradeId) && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(gradeId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isSignedIn() && isValidId(gradeId) && isValidScopedDoc(incoming()) && resource != null && hasSchoolField(existing()) && unchangedSchoolId() && (
        isSuperAdmin() ||
        (isSchoolAdmin(existing().school_id) && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(gradeId) && resource != null && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id)) ||
        (resource == null && hasUserProfile() && userProfile().school_id != null && settingId == ('school_' + string(userProfile().school_id) + '_config'))
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(settingId) && isValidScopedDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isSignedIn() && isValidId(settingId) && isValidScopedDoc(incoming()) && resource != null && hasSchoolField(existing()) && unchangedSchoolId() && (
        isSuperAdmin() ||
        (isSchoolAdmin(existing().school_id) && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(settingId) && resource != null && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }

    match /app_data/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && (
        isSuperAdmin() ||
        (resource != null && hasSchoolField(existing()) && isSameSchool(existing().school_id))
      );
      allow list: if false;
      allow create: if isSignedIn() && isValidId(docId) && isValidAppDataDoc(incoming()) && (isSuperAdmin() || isSchoolAdmin(incoming().school_id));
      allow update: if isSignedIn() && isValidId(docId) && isValidAppDataDoc(incoming()) && resource != null && hasSchoolField(existing()) && unchangedSchoolId() && (
        isSuperAdmin() ||
        (isSchoolAdmin(existing().school_id) && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(docId) && resource != null && hasSchoolField(existing()) && (isSuperAdmin() || isSchoolAdmin(existing().school_id));
    }
  }
}
