# FedaPay Keys
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Set to 'sandbox' or 'live'
FEDAPAY_MODE=sandbox

# =====================================================================
# Configuration Envoi d'Emails, SMS & WhatsApp (Brevo / SMTP / Gmail)
# Option 1 : Brevo API Transactionnelle (Email, SMS, WhatsApp)
#   BREVO_API_KEY=votre_cle_api_brevo
# Option 2 : Brevo Relais SMTP (smtp-relay.brevo.com, Port 587)
# Option 3 : Gmail (smtp.gmail.com + Mot de passe d'application)
# =====================================================================
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SCHOOL_NAME=MégafixaEduc

# Security & Server
PORT=10000
JWT_SECRET=your_jwt_secret_here
DATABASE_PATH=megafixaEduc.db
NODE_ENV=production
OFFLINE_MODE=false

# Google Auth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI (Optional)
GEMINI_API_KEY=

# OpenAI ChatGPT (Optional)
OPENAI_API_KEY=
