# FedaPay Keys
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Set to 'sandbox' or 'live'
FEDAPAY_MODE=sandbox

# =====================================================================
# Configuration Envoi d'Emails, SMS & WhatsApp (Brevo / SMTP / Gmail)
# Option 1 : Brevo API Transactionnelle (Email, SMS, WhatsApp)
#   BREVO_API_KEY=votre_cle_api_brevo
# Option 2 : Brevo Relais SMTP (smtp-relay.brevo.com, Port 587)
# Option 3 : Gmail (smtp.gmail.com + Mot de passe d'application)
# =====================================================================
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=megafixatecheduc@gmail.com
SMTP_PASS=ilcn nwkc xuls sofc
EMAIL_FROM=
SCHOOL_NAME=MégafixaEduc

# Security & Server
PORT=10000
JWT_SECRET=your_jwt_secret_here
DATABASE_PATH=megafixaEduc.db
# Optionnel : pour un hébergement avec disque persistant (ex: /var/data/megafixaEduc.db),
# BACKUPS_DIR et UPLOADS_DIR suivent automatiquement le dossier de DATABASE_PATH sauf surcharge :
BACKUPS_DIR=
UPLOADS_DIR=
# Optionnel : JSON du compte de service Firebase Admin pour la sauvegarde Cloud automatique
FIREBASE_SERVICE_ACCOUNT=
NODE_ENV=production
OFFLINE_MODE=false

# Google Auth (Optionnel - déjà géré automatiquement via Firebase Auth / firebase-applet-config.json)
# Client ID utilisé par l'app : laisser vide ici (défini dans firebase-applet-config.json), ou surcharger en déploiement si besoin.
# GOOGLE_CLIENT_SECRET n'est pas nécessaire (authentification Google & Workspace 100% côté client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI (Optional)
GEMINI_API_KEY=

# OpenAI ChatGPT (Optional)
OPENAI_API_KEY=
