# FedaPay Keys
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Set to 'sandbox' or 'live'
FEDAPAY_MODE=sandbox

# =====================================================================
# Configuration Envoi d'Emails, SMS & WhatsApp (Brevo / SMTP / Gmail)
# IMPORTANT SÉCURITÉ : NE JAMAIS mettre de vraies clés API ou mots de passe
# dans ce fichier .env.example (il est suivi par Git / GitHub).
# Renseignez vos vraies clés uniquement dans :
#   1) Les variables d'environnement de votre hébergeur (Render / Cloud)
#   2) Ou directement dans Super Admin -> Paramètres -> Emails & Notifications
# =====================================================================
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SCHOOL_NAME=MégafixaEduc

# Security & Server
PORT=10000
JWT_SECRET=
DATABASE_PATH=megafixaEduc.db
# Optionnel : pour un hébergement avec disque persistant (ex: /var/data/megafixaEduc.db),
# BACKUPS_DIR et UPLOADS_DIR suivent automatiquement le dossier de DATABASE_PATH sauf surcharge :
BACKUPS_DIR=
UPLOADS_DIR=
# Optionnel : JSON du compte de service Firebase Admin pour la sauvegarde Cloud automatique
FIREBASE_SERVICE_ACCOUNT=
NODE_ENV=production
OFFLINE_MODE=false

# Google Auth (Optionnel - déjà géré automatiquement via Firebase Auth / firebase-applet-config.json)
# GOOGLE_CLIENT_SECRET n'est pas nécessaire (authentification Google & Workspace 100% côté client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI (Optional)
GEMINI_API_KEY=

# OpenAI ChatGPT (Optional)
OPENAI_API_KEY=
